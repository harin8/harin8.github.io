# Anthropic Claude API key (server-side only — never expose)
ANTHROPIC_API_KEY=sk-ant-...

# Upstash Redis for rate-limiting the chat endpoint.
# Create a free Redis database at https://upstash.com/, then copy the
# REST URL and REST token from the database details page.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...
